{
	"devDependencies": {
		"@aeonixdev/configs": "github:AeonixDev/configs",
		"@biomejs/biome": "2.5.3",
		"prettier": "3.9.5",
		"prettier-plugin-svelte": "4.1.1"
	},
	"name": "aeonixdev-ui",
	"packageManager": "bun@1.3.14",
	"private": true,
	"scripts": {
		"build-storybook": "bun run --cwd package build-storybook",
		"build:dashboard": "bun run --cwd examples/dashboard build",
		"check": "bun run --cwd package check",
		"check:dashboard": "bun run --cwd examples/dashboard check",
		"check:package": "bun pm pack --cwd package --dry-run --ignore-scripts",
		"format": "prettier --write . && biome check --write .",
		"format:check": "prettier --check .",
		"format:unsafe": "biome check --write --unsafe .",
		"lint": "biome check .",
		"storybook": "bun run --cwd package storybook"
	},
	"workspaces": [
		"examples/dashboard",
		"package"
	]
}
